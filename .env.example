# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Which provider the LLMProvider abstraction resolves to: groq | gemini
# The committed cache in data/cache/llm was built by Gemini, and a cache key
# includes the provider -- so a fully-offline run must be configured as gemini
# or it will miss every entry. Switch to groq only if you are recomputing.
LLM_PROVIDER=gemini

# Never commit real keys. Copy this file to .env and fill it in locally.
GROQ_API_KEY=
# Also accepted: GOOGLE_API_KEY, or either name with an IA_ prefix.
GEMINI_API_KEY=

# Model per provider (kept separate so switching provider is a one-line change)
# Check `client.models.list()` -- available models differ per key.
GROQ_MODEL=openai/gpt-oss-120b
# 2.5-flash-lite is closed to new keys; the API redirects to 3.5.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# LLM behaviour
# ---------------------------------------------------------------------------
# When true the app refuses to make network LLM calls and serves cached results
# only. This is how the deployed demo runs: no API key required.
LLM_OFFLINE=false
# One JSON file per key, committed to git. This is what lets the demo run
# with no API key at all.
LLM_CACHE_DIR=data/cache/llm
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Data / storage
# ---------------------------------------------------------------------------
DB_PATH=data/crm.db
RAW_PEOPLE_PATH=data/raw/people_raw.json

# ---------------------------------------------------------------------------
# Embeddings (local CPU only, no API key)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
